# Local server only. Vercel supplies its own host and port.
HOST=127.0.0.1
PORT=4173

# Backend media proxy. These defaults work with the current public Drive folder.
GOOGLE_DRIVE_DOWNLOAD_ORIGIN=https://drive.usercontent.google.com
MEDIA_CACHE_SECONDS=3600

# Optional comma-separated Google Drive IDs added after deployment.
EXTRA_MEDIA_IDS=
